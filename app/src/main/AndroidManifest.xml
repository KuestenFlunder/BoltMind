<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Kamera & Fotos.

      Keine CAMERA-Berechtigung: die App fotografiert ausschliesslich ueber die
      System-Kamera (ACTION_IMAGE_CAPTURE), die ihre Berechtigung selbst verwaltet
      (governance.md, Abschnitt "Kamera"). Steht die Berechtigung im Manifest, ohne
      erteilt zu sein, verweigert das System ACTION_IMAGE_CAPTURE mit einer
      SecurityException. Die Deklaration wuerde die Aufnahme also aktiv kaputt
      machen.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BoltMindApplication"
        android:allowBackup = "true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoltMind">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BoltMind">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
