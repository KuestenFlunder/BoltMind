<?xml version="1.0" encoding="utf-8"?>
<!--
  Texte der Uebersicht (F-001).

  Woertlich aus dem Design-Prototyp "BoltMind App.dc.html", Zeilen 60-116 und
  576-579. Eigene Datei, damit sich die parallel entstehenden Screens nicht in
  strings.xml in die Quere kommen.

  Nicht hier: die Datumsformate ("Gerade eben", "Heute, hh:mm", ...). Die
  Formatierung liegt im ViewModel und muss ohne Android testbar sein – ihre
  Wortlaute stehen deshalb in DatumFormat.kt.
-->
<resources>

    <!-- Kopfzeile, Prototyp Z. 68-69 -->
    <string name="uebersicht_logo">B</string>
    <string name="uebersicht_wortmarke">BOLTMIND</string>

    <!-- Tabs, Prototyp Z. 74-79 -->
    <string name="uebersicht_tab_offen">OFFEN</string>
    <string name="uebersicht_tab_archiv">ARCHIV</string>

