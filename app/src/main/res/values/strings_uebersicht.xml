    <string name="uebersicht_teile">%1$d TEILE</string>
    <string name="uebersicht_chevron">›</string>
    <string name="uebersicht_fahrzeugfoto">Fahrzeugfoto</string>
    <!-- Der Prototyp kennt keinen fehlenden Bildpfad; ohne Datei darf die Karte nicht abstuerzen. -->
    <string name="uebersicht_kein_foto">KEIN FOTO</string>

    <!-- Leerzustand, Prototyp Z. 99-103 -->
